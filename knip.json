{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx",
    "scripts/**/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "ignore": [
    "src/editor/reference_index.ts",
    "src/rendering/ui/editor_object_renderer.ts",
    "src/rendering/ui/where_used.ui.ts"
  ],
  "ignoreDependencies": [
    "@types/jszip"
  ]
}
