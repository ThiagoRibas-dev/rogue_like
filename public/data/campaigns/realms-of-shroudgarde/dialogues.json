{
  "guard_captain_tree": {
    "id": "guard_captain_tree",
    "title": "Constable Derek",
    "startNodeId": "root",
    "nodes": {
      "root": {
        "id": "root",
        "text": "Stand, traveler! The Borderlands are under martial watch. Between the cultist incursions and the trance affliction, I cannot allow careless wanderers through.",
        "options": [
          {
            "id": "opt_diplomacy",
            "text": "[Diplomacy DC 14] I am an able adventurer here to aid Shroudgarde in securing the frontier.",
            "conditions": [
              {
                "type": "not_has_fact",
                "target": "received_derek_signet"
              }
            ],
            "consequences": [
              {
                "type": "skill_check",
                "skillId": "diplomacy",
                "dc": 14,
                "onSuccessNodeId": "node_diplo_pass",
                "onFailureNodeId": "node_diplo_fail"
              }
            ]
          },
          {
            "id": "opt_intimidate",
            "text": "[Intimidate DC 16] Out of my way, Constable. I have slain deadlier threats than you.",
            "consequences": [
              {
                "type": "skill_check",
                "skillId": "intimidate",
                "dc": 16,
                "onSuccessNodeId": "node_intim_pass",
                "onFailureNodeId": "node_intim_fail"
              }
            ]
          },
          {
            "id": "opt_bounties",
            "text": "What bounties or duties are posted for Shroudgarde defenders?",
            "nextNodeId": "node_bounties"
          },
          {
            "id": "opt_leave",
            "text": "Forgive me, Constable. I will take my leave."
          }
        ]
      },
      "node_diplo_pass": {
        "id": "node_diplo_pass",
        "text": "Well spoken. We need all the steel we can muster. Take this Guard Signet — it proves your authority to explore the ruins and report back.",
        "options": [
          {
            "id": "opt_accept_signet",
            "text": "Thank you, Constable. I will not fail.",
            "conditions": [
              {
                "type": "not_has_fact",
                "target": "received_derek_signet"
              }
            ],
            "consequences": [
              {
                "type": "set_attitude",
                "attitude": "friendly"
              },
              {
                "type": "give_item",
                "itemId": "shroudgarde_signet",
                "quantity": 1
              },
              {
                "type": "set_fact",
                "target": "received_derek_signet"
              }
            ]
          },
          {
            "id": "opt_back_signed",
            "text": "Return to duties.",
            "nextNodeId": "root"
          }
        ]
      },
      "node_diplo_fail": {
        "id": "node_diplo_fail",
        "text": "Pretty words do not swing a blade against an orc warband. Come back when you have proven your mettle.",
        "options": [
          {
            "id": "opt_back",
            "text": "Understood.",
            "nextNodeId": "root"
          }
        ]
      },
      "node_intim_pass": {
        "id": "node_intim_pass",
        "text": "T-there is no need for hostility! Pass through if you must, but whatever happens out there is on your own head!",
        "options": [
          {
            "id": "opt_pass",
            "text": "Hmph. Wise choice."
          }
        ]
      },
      "node_intim_fail": {
        "id": "node_intim_fail",
        "text": "You threaten a sworn officer of the realm? Watch your tongue before I have you clapped in irons!",
        "options": [
          {
            "id": "opt_back",
            "text": "Step back.",
            "nextNodeId": "root"
          }
        ]
      },
      "node_bounties": {
        "id": "node_bounties",
        "text": "Several urgent threats loom across the frontier. Which assignment will you accept?",
        "options": [
          {
            "id": "opt_q_crypts",
            "text": "[Quest] Cleanse the Sunless Crypts of the restless dead.",
            "conditions": [
              {
                "type": "quest_status",
                "target": "quest_cleanse_crypts",
                "operator": "==",
                "value": -1
              }
            ],
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "quest_cleanse_crypts"
              }
            ],
            "nextNodeId": "node_bounties"
          },
          {
            "id": "opt_q_watchtower",
            "text": "[Quest] Drive the bandit cutthroats from the High Watchtower.",
            "conditions": [
              {
                "type": "quest_status",
                "target": "quest_watchtower_defense",
                "operator": "==",
                "value": -1
              }
            ],
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "quest_watchtower_defense"
              }
            ],
            "nextNodeId": "node_bounties"
          },
          {
            "id": "opt_q_caves",
            "text": "[Quest] Root out the Ravine of Chaos and slay Korag the Ogre Chieftain.",
            "conditions": [
              {
                "type": "quest_status",
                "target": "quest_caves_of_chaos",
                "operator": "==",
                "value": -1
              }
            ],
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "quest_caves_of_chaos"
              }
            ],
            "nextNodeId": "node_bounties"
          },
          {
            "id": "opt_q_moathouse",
            "text": "[Quest] Infiltrate the Moathouse and defeat Lareth the Beautiful.",
            "conditions": [
              {
                "type": "quest_status",
                "target": "quest_moathouse_incursion",
                "operator": "==",
                "value": -1
              }
            ],
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "quest_moathouse_incursion"
              }
            ],
            "nextNodeId": "node_bounties"
          },
          {
            "id": "opt_bounties_back",
            "text": "Back to the gatehouse.",
            "nextNodeId": "root"
          }
        ]
      }
    }
  },
  "bertram_trade_tree": {
    "id": "bertram_trade_tree",
    "title": "Barkeep Bertram",
    "startNodeId": "root",
    "nodes": {
      "root": {
        "id": "root",
        "text": "Welcome to the Golden Grain, stranger! Finest ale and warmest hearth in the Borderlands. What can I fetch you?",
        "options": [
          {
            "id": "opt_trade",
            "text": "Show me your rations and provisions.",
            "consequences": [
              {
                "type": "open_barter"
              }
            ]
          },
          {
            "id": "opt_quest_supplies",
            "text": "[Quest] Need a hand sorting provisions for the Golden Grain?",
            "conditions": [
              {
                "type": "quest_status",
                "target": "quest_barkeep_supplies",
                "operator": "==",
                "value": -1
              }
            ],
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "quest_barkeep_supplies"
              }
            ],
            "nextNodeId": "root"
          },
          {
            "id": "opt_appraise",
            "text": "[Appraise DC 12] Your supplier from Orlane overcharged you on that batch of wheat.",
            "conditions": [
              {
                "type": "not_has_fact",
                "target": "bertram_appraise_used"
              }
            ],
            "consequences": [
              {
                "type": "skill_check",
                "skillId": "appraise",
                "dc": 12,
                "onSuccessNodeId": "node_appraise_win",
                "onFailureNodeId": "node_appraise_loss",
                "successConsequences": [
                  {
                    "type": "set_fact",
                    "target": "bertram_appraise_used"
                  }
                ],
                "failureConsequences": [
                  {
                    "type": "set_fact",
                    "target": "bertram_appraise_used"
                  }
                ]
              }
            ]
          },
          {
            "id": "opt_bluff",
            "text": "[Bluff DC 14] Constable Derek sent me for complimentary provisions for our patrol.",
            "conditions": [
              {
                "type": "not_has_fact",
                "target": "bertram_bread_used"
              }
            ],
            "consequences": [
              {
                "type": "skill_check",
                "skillId": "bluff",
                "dc": 14,
                "onSuccessNodeId": "node_bluff_win",
                "onFailureNodeId": "node_bluff_loss",
                "successConsequences": [
                  {
                    "type": "set_fact",
                    "target": "bertram_bread_used"
                  }
                ],
                "failureConsequences": [
                  {
                    "type": "set_fact",
                    "target": "bertram_bread_used"
                  }
                ]
              }
            ]
          },
          {
            "id": "opt_rumors",
            "text": "Any rumors of the surrounding ruins?",
            "nextNodeId": "node_rumors"
          }
        ]
      },
      "node_appraise_win": {
        "id": "node_appraise_win",
        "text": "By the gods, you are right! The grain sacks are cut with chaff. You have sharp eyes! Here, take a 15% discount on anything in my tavern.",
        "options": [
          {
            "id": "opt_trade_disc",
            "text": "Much appreciated, Bertram. Let me see your wares.",
            "conditions": [
              {
                "type": "not_has_fact",
                "target": "bertram_discount_applied"
              }
            ],
            "consequences": [
              {
                "type": "modify_session_markup",
                "delta": -0.15
              },
              {
                "type": "set_fact",
                "target": "bertram_discount_applied"
              },
              {
                "type": "open_barter"
              }
            ]
          }
        ]
      },
      "node_appraise_loss": {
        "id": "node_appraise_loss",
        "text": "Nonsense! Bertram knows good barley when he sees it. No discounts for amateur critics!",
        "options": [
          {
            "id": "opt_trade_std",
            "text": "Fair enough. Show me what you have.",
            "consequences": [
              {
                "type": "open_barter"
              }
            ]
          }
        ]
      },
      "node_bluff_win": {
        "id": "node_bluff_win",
        "text": "Ah, Derek's boys! Never let it be said Bertram neglected the town guard. Here is a fresh loaf of crusty bread on the house!",
        "options": [
          {
            "id": "opt_trade_free",
            "text": "Much obliged.",
            "conditions": [
              {
                "type": "not_has_fact",
                "target": "received_bertram_bread"
              }
            ],
            "consequences": [
              {
                "type": "give_item",
                "itemId": "ration_fresh_bread",
                "quantity": 1
              },
              {
                "type": "set_fact",
                "target": "received_bertram_bread"
              },
              {
                "type": "open_barter"
              }
            ]
          }
        ]
      },
      "node_bluff_loss": {
        "id": "node_bluff_loss",
        "text": "Derek pays in coin like everyone else! Do you take me for a fool?",
        "options": [
          {
            "id": "opt_back",
            "text": "Never mind.",
            "nextNodeId": "root"
          }
        ]
      },
      "node_rumors": {
        "id": "node_rumors",
        "text": "They say dark chanting echoes from the old Moathouse at midnight. And deeper still, past the Sunless Crypts, lies an endless subterranean abyss...",
        "options": [
          {
            "id": "opt_back",
            "text": "Thank you for the warning.",
            "nextNodeId": "root"
          }
        ]
      }
    }
  },
  "laurent_smith_tree": {
    "id": "laurent_smith_tree",
    "title": "Gold Dwarf Laurent",
    "startNodeId": "root",
    "nodes": {
      "root": {
        "id": "root",
        "text": "Clang and sparks! Keep back from the forge coals, surface-dweller. Looking for dwarf-forged iron that will not shatter against goblin bone?",
        "options": [
          {
            "id": "opt_trade",
            "text": "Let me see your weapons and armor.",
            "consequences": [
              {
                "type": "open_barter"
              }
            ]
          },
          {
            "id": "opt_appraise",
            "text": "[Appraise DC 15] This breastplate has exceptional fold-welding. You take immense pride in your craft.",
            "conditions": [
              {
                "type": "not_has_fact",
                "target": "laurent_appraise_used"
              }
            ],
            "consequences": [
              {
                "type": "skill_check",
                "skillId": "appraise",
                "dc": 15,
                "onSuccessNodeId": "node_smith_praise_pass",
                "onFailureNodeId": "node_smith_praise_fail",
                "successConsequences": [
                  {
                    "type": "set_fact",
                    "target": "laurent_appraise_used"
                  }
                ],
                "failureConsequences": [
                  {
                    "type": "set_fact",
                    "target": "laurent_appraise_used"
                  }
                ]
              }
            ]
          },
          {
            "id": "opt_q_warrens",
            "text": "[Quest] Tell me about the Goblin Warrens threatening the deep roads.",
            "conditions": [
              {
                "type": "quest_status",
                "target": "quest_goblin_warrens",
                "operator": "==",
                "value": -1
              }
            ],
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "quest_goblin_warrens"
              }
            ],
            "nextNodeId": "root"
          },
          {
            "id": "opt_adamantine",
            "text": "Can you forge adamantine gear?",
            "nextNodeId": "node_ore"
          }
        ]
      },
      "node_smith_praise_pass": {
        "id": "node_smith_praise_pass",
        "text": "Ha! A surface-dweller with genuine appreciation for proper metallurgy! It is rare to meet someone who understands temper and quench. For you, artisan discount!",
        "options": [
          {
            "id": "opt_trade_pass",
            "text": "Show me your armory, Master Laurent.",
            "conditions": [
              {
                "type": "not_has_fact",
                "target": "laurent_discount_applied"
              }
            ],
            "consequences": [
              {
                "type": "modify_session_markup",
                "delta": -0.1
              },
              {
                "type": "set_fact",
                "target": "laurent_discount_applied"
              },
              {
                "type": "open_barter"
              }
            ]
          }
        ]
      },
      "node_smith_praise_fail": {
        "id": "node_smith_praise_fail",
        "text": "Do not flatter me to get a coin shaved off! Good steel costs what it costs.",
        "options": [
          {
            "id": "opt_trade_std",
            "text": "Fair enough. Let me browse.",
            "consequences": [
              {
                "type": "open_barter"
              }
            ]
          }
        ]
      },
      "node_ore": {
        "id": "node_ore",
        "text": "If you bring me pure adamantine ore from the deepest vaults beneath the Dungeons of Doom, I will forge weapons worthy of kings!",
        "options": [
          {
            "id": "opt_q_ore",
            "text": "[Quest] I will locate the Adamantine Hoard vault.",
            "conditions": [
              {
                "type": "quest_status",
                "target": "quest_laurent_special_ore",
                "operator": "==",
                "value": -1
              }
            ],
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "quest_laurent_special_ore"
              }
            ],
            "nextNodeId": "root"
          },
          {
            "id": "opt_back",
            "text": "I will remember that.",
            "nextNodeId": "root"
          }
        ]
      }
    }
  },
  "isabelle_healer_tree": {
