  "alden_mage_tree": {
    "id": "alden_mage_tree",
    "title": "Archmage Alden",
    "startNodeId": "root",
    "nodes": {
      "root": {
        "id": "root",
        "text": "Ah, a wanderer entering my tower without triggering the warding runes. Impressive. Do you seek arcane knowledge, scrolls, or wands?",
        "options": [
          {
            "id": "opt_trade",
            "text": "I seek magical scrolls and wands.",
            "consequences": [
              {
                "type": "open_barter"
              }
            ]
          },
          {
            "id": "opt_q_tome",
            "text": "[Quest] I can ascend to the Sanctum Sanctorum and retrieve your celestial grimoire.",
            "conditions": [
              {
                "type": "quest_status",
                "target": "quest_alden_lost_tome",
                "operator": "==",
                "value": -1
              }
            ],
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "quest_alden_lost_tome"
              }
            ],
            "nextNodeId": "root"
          },
          {
            "id": "opt_q_doom",
            "text": "[Quest] What stirs in the ten depths of the Dungeons of Doom?",
            "conditions": [
              {
                "type": "quest_status",
                "target": "quest_megadungeon_depths",
                "operator": "==",
                "value": -1
              }
            ],
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "quest_megadungeon_depths"
              }
            ],
            "nextNodeId": "root"
          },
          {
            "id": "opt_q_dragon",
            "text": "[Quest] Tell me of Pyroclast the Red Wyrm beneath the vaults.",
            "conditions": [
              {
                "type": "quest_status",
                "target": "quest_slay_dragon_pyroclast",
                "operator": "==",
                "value": -1
              }
            ],
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "quest_slay_dragon_pyroclast"
              }
            ],
            "nextNodeId": "root"
          },
          {
            "id": "opt_bluff",
            "text": "[Bluff DC 15] I am an emissary from the High Arcane Synod evaluating frontier towers.",
            "conditions": [
              {
                "type": "not_has_fact",
                "target": "alden_bluff_used"
              }
            ],
            "consequences": [
              {
                "type": "skill_check",
                "skillId": "bluff",
                "dc": 15,
                "onSuccessNodeId": "node_mage_pass",
                "onFailureNodeId": "node_mage_fail",
                "successConsequences": [
                  {
                    "type": "set_fact",
                    "target": "alden_bluff_used"
                  }
                ],
                "failureConsequences": [
                  {
                    "type": "set_fact",
                    "target": "alden_bluff_used"
                  }
                ]
              }
            ]
          }
        ]
      },
      "node_mage_pass": {
        "id": "node_mage_pass",
        "text": "The Synod? I was not notified! Of course, my facilities are at the disposal of esteemed colleagues.",
        "options": [
          {
            "id": "opt_trade_pass",
            "text": "Show me your grimoires.",
            "conditions": [
              {
                "type": "not_has_fact",
                "target": "alden_discount_applied"
              }
            ],
            "consequences": [
              {
                "type": "modify_session_markup",
                "delta": -0.2
              },
              {
                "type": "set_fact",
                "target": "alden_discount_applied"
              },
              {
                "type": "open_barter"
              }
            ]
          }
        ]
      },
      "node_mage_fail": {
        "id": "node_mage_fail",
        "text": "The Synod uses celestial seals, charlatan. Do not insult my centuries of study with crude deception!",
        "options": [
          {
            "id": "opt_trade_std",
            "text": "My apologies. Let me view your inventory.",
            "consequences": [
              {
                "type": "open_barter"
              }
            ]
          }
        ]
      }
    }
  },
  "elena_scholar_tree": {
    "id": "elena_scholar_tree",
    "title": "Elena the Chronicler",
    "startNodeId": "root",
    "nodes": {
      "root": {
        "id": "root",
        "text": "I transcribe the histories of Shroudgarde and the fallen temples. What lore do you seek?",
        "options": [
          {
            "id": "opt_toee",
            "text": "Tell me of the Temple of Elemental Evil.",
            "nextNodeId": "node_toee"
          },
          {
            "id": "opt_trance",
            "text": "What is the trance affliction gripping the peasants?",
            "nextNodeId": "node_trance"
          }
        ]
      },
      "node_toee": {
        "id": "node_toee",
        "text": "Built atop a subterranean tear into the Lower Planes, the Temple was sealed decades ago. Yet rumors say cultists reassemble in the ruins of the Moathouse to breach the seals and awaken Zuggtmoy...",
        "options": [
          {
            "id": "opt_q_toee",
            "text": "[Quest] I will descend into the Temple of Elemental Evil and banish Zuggtmoy.",
            "conditions": [
              {
                "type": "quest_status",
                "target": "quest_temple_of_elemental_evil",
                "operator": "==",
                "value": -1
              }
            ],
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "quest_temple_of_elemental_evil"
              }
            ],
            "nextNodeId": "root"
          },
          {
            "id": "opt_back",
            "text": "Thank you, Elena.",
            "nextNodeId": "root"
          }
        ]
      },
      "node_trance": {
        "id": "node_trance",
        "text": "The afflicted wander as if dreaming, muttering of a fungal goddess in the deep fane. It is no natural disease; tracks lead toward the Mirrored Marsh.",
        "options": [
          {
            "id": "opt_q_trance",
            "text": "[Quest] I will investigate the Whispering Trance in the Mirrored Marsh.",
            "conditions": [
              {
                "type": "quest_status",
                "target": "quest_investigate_trance",
                "operator": "==",
                "value": -1
              }
            ],
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "quest_investigate_trance"
              }
            ],
            "nextNodeId": "root"
          },
          {
            "id": "opt_back",
            "text": "Frightening. I must be careful.",
            "nextNodeId": "root"
          }
        ]
      }
    }
  },
  "villager_dialogue_tree": {
    "id": "villager_dialogue_tree",
    "title": "Shroudgarde Commoner",
    "startNodeId": "root",
    "nodes": {
      "root": {
        "id": "root",
        "text": "Please, traveler... keep the monsters away from our thatched roofs. The night howls grow louder every moon.",
        "options": [
          {
            "id": "opt_comfort",
            "text": "Stay safe inside the walls. We will handle the menace."
          }
        ]
      }
    }
  },
  "lareth_parley_tree": {
    "id": "lareth_parley_tree",
    "title": "Lareth the Beautiful",
    "startNodeId": "root",
    "nodes": {
      "root": {
        "id": "root",
        "text": "Another mercenary sent by Constable Derek? How tragic that such vitality must end so brutally in the mud.",
        "options": [
          {
            "id": "opt_intimidate",
            "text": "[Intimidate DC 17] Yield the Moathouse, Lareth, or Derek will display your head on the gate!",
            "consequences": [
              {
                "type": "skill_check",
                "skillId": "intimidate",
                "dc": 17,
                "onSuccessNodeId": "node_lareth_shake",
                "onFailureNodeId": "node_lareth_laugh"
              }
            ]
          },
          {
            "id": "opt_fight",
            "text": "Draw your blade, cultist scum!"
          }
        ]
      },
      "node_lareth_shake": {
        "id": "node_lareth_shake",
        "text": "You... you are stronger than the others. Perhaps we can reach an accommodation before steel is drawn...",
        "options": [
          {
            "id": "opt_strike",
            "text": "No accommodations with the servants of evil!"
          }
        ]
      },
      "node_lareth_laugh": {
        "id": "node_lareth_laugh",
        "text": "Hahaha! Empty bravado! The Temple of Elemental Evil will swallow your pathetic bones!",
        "options": [
          {
            "id": "opt_strike",
            "text": "Have at you!"
          }
        ]
      }
    }
  },
  "dragon_dialogue_tree": {
    "id": "dragon_dialogue_tree",
    "title": "Pyroclast the Red Wyrm",
    "startNodeId": "root",
    "nodes": {
      "root": {
        "id": "root",
        "text": "A mortal worm dares trespass upon my golden hoard? Speak your final words before you are reduced to cinder and ash!",
        "options": [
          {
            "id": "opt_diplomacy",
            "text": "[Diplomacy DC 20] O Great Pyroclast, I bring offerings and tribute from the surface lords!",
            "consequences": [
              {
                "type": "skill_check",
                "skillId": "diplomacy",
                "dc": 20,
                "onSuccessNodeId": "node_dragon_pass",
                "onFailureNodeId": "node_dragon_fail"
              }
            ]
          },
          {
            "id": "opt_fight",
            "text": "I come not to bow, but to claim your hoard and slay you!"
          }
        ]
      },
      "node_dragon_pass": {
        "id": "node_dragon_pass",
        "text": "Hmm. You show proper reverence, tiny creature. Drop your tribute and crawl away, while my mercy endures.",
        "options": [
          {
            "id": "opt_flee",
            "text": "Tread carefully backward."
          }
        ]
      },
      "node_dragon_fail": {
        "id": "node_dragon_fail",
        "text": "Fool! Your tribute is pitiful and your arrogance is fatal! BURN!",
        "options": [
          {
            "id": "opt_combat",
            "text": "Brace for flame!"
          }
        ]
      }
    }
  }
}
