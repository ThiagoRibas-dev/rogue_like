{
  "tutorial_npc_dialogue": {
    "id": "tutorial_npc_dialogue",
    "startNodeId": "start",
    "nodes": {
      "start": {
        "id": "start",
        "text": "Greetings, traveler. I see you've survived the dungeon thus far. Have you seen any goblins?",
        "options": [
          {
            "id": "opt_yes_goblins",
            "text": "Yes, I've fought a few.",
            "nextNodeId": "seen_goblins"
          },
          {
            "id": "opt_no_goblins",
            "text": "Not yet.",
            "nextNodeId": "no_goblins"
          },
          {
            "id": "opt_turn_in",
            "text": "I've handled your [Goblin](entity:goblin) problem.",
            "nextNodeId": "quest_complete",
            "conditions": [
              {
                "type": "quest_status",
                "params": {
                  "target": "tutorial_quest",
                  "operator": "==",
                  "value": 0
                }
              }
            ],
            "consequences": [
              {
                "type": "complete_quest",
                "params": {
                  "targetId": "tutorial_quest"
                }
              }
            ]
          },
          {
            "id": "opt_ask_work",
            "text": "Do you have any other work? (Ask for work)",
            "nextNodeId": "grant_dynamic",
            "conditions": [
              {
                "type": "not_has_fact",
                "params": {
                  "target": "gave_bounty_kill"
                }
              }
            ]
          },
          {
            "id": "opt_leave",
            "text": "I must be going. (Leave)"
          }
        ]
      },
      "quest_complete": {
        "id": "quest_complete",
        "text": "Excellent! Here is your reward.",
        "options": [
          {
            "id": "opt_bye2",
            "text": "Thanks. (Leave)"
          }
        ]
      },
      "grant_dynamic": {
        "id": "grant_dynamic",
        "text": "There are always bounties. Here is one of them.",
        "options": [
          {
            "id": "opt_take_bounty",
            "text": "I will handle it.",
            "consequences": [
              {
                "type": "grant_dynamic_quest",
                "params": {
                  "targetId": "bounty_kill"
                }
              }
            ]
          }
        ]
      },
      "seen_goblins": {
        "id": "seen_goblins",
        "text": "They are a menace. If you plan to go deeper, clear them out. I will reward you.",
        "options": [
          {
            "id": "opt_accept_quest",
            "text": "I'll take care of them. (Accept Quest)",
            "consequences": [
              {
                "type": "grant_quest",
                "params": {
                  "targetId": "tutorial_quest"
                }
              }
            ]
          },
          {
            "id": "opt_thanks",
            "text": "I have my own problems. (Leave)"
          }
        ]
      },
      "no_goblins": {
        "id": "no_goblins",
        "text": "You are lucky then. They usually swarm this upper level.",
        "options": [
          {
            "id": "opt_bye",
            "text": "Good to know. (Leave)"
          }
        ]
      }
    }
  }
}
