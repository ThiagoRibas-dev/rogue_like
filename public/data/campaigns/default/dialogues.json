{
  "tutorial_npc_dialogue": {
    "id": "tutorial_npc_dialogue",
    "startNodeId": "start",
    "nodes": {
      "start": {
        "id": "start",
        "text": "Greetings, traveler. I see you've survived the dungeon thus far. Have you seen any goblins?",
        "options": [
          {
            "id": "opt_yes_goblins",
            "text": "Yes, I've fought a few.",
            "nextNodeId": "seen_goblins"
          },
          {
            "id": "opt_no_goblins",
            "text": "Not yet.",
            "nextNodeId": "no_goblins"
          },
          {
            "id": "opt_turn_in",
            "text": "I've handled your [Goblin](entity:goblin) problem.",
            "nextNodeId": "quest_complete",
            "conditions": [
              {
                "type": "quest_status",
                "target": "tutorial_quest",
                "operator": "==",
                "value": 0
              }
            ],
            "consequences": [
              {
                "type": "complete_quest",
                "targetId": "tutorial_quest"
              }
            ]
          },
          {
            "id": "opt_ask_work",
            "text": "Do you have any other work? (Ask for work)",
            "nextNodeId": "grant_dynamic",
            "conditions": [
              {
                "type": "not_has_fact",
                "target": "gave_bounty_kill"
              }
            ]
          },
          {
            "id": "opt_leave",
            "text": "I must be going. (Leave)"
          }
        ]
      },
      "quest_complete": {
        "id": "quest_complete",
        "text": "Excellent! Here is your reward.",
        "options": [
          {
            "id": "opt_bye2",
            "text": "Thanks. (Leave)"
          }
        ]
      },
      "grant_dynamic": {
        "id": "grant_dynamic",
        "text": "There are always bounties. Here is one of them.",
        "options": [
          {
            "id": "opt_take_bounty",
            "text": "I will handle it.",
            "consequences": [
              {
                "type": "grant_quest",
                "targetId": "bounty_kill"
              }
            ]
          }
        ]
      },
      "seen_goblins": {
        "id": "seen_goblins",
        "text": "They are a menace. If you plan to go deeper, clear them out. I will reward you.",
        "options": [
          {
            "id": "opt_accept_quest",
            "text": "I'll take care of them. (Accept Quest)",
            "consequences": [
              {
                "type": "grant_quest",
                "targetId": "tutorial_quest"
              }
            ]
          },
          {
            "id": "opt_thanks",
            "text": "I have my own problems. (Leave)"
          }
        ]
      },
      "no_goblins": {
        "id": "no_goblins",
        "text": "You are lucky then. They usually swarm this upper level.",
        "options": [
          {
            "id": "opt_bye",
            "text": "Good to know. (Leave)"
          }
        ]
      }
    }
  },
  "barkeeper_tree": {
    "id": "barkeeper_tree",
    "startNodeId": "start",
    "nodes": {
      "start": {
        "id": "start",
        "text": "Welcome to my stand, traveler. What can I do for you?",
        "options": [
          {
            "id": "opt_grant_main_quest",
            "text": "I hear you need help dealing with the bandit leader. (Accept Quest)",
            "nextNodeId": "grant_main_quest_node",
            "conditions": [
              {
                "type": "quest_status",
                "target": "main_quest_bandit_king",
                "operator": "==",
                "value": -1
              }
            ]
          },
          {
            "id": "opt_complete_main_quest",
            "text": "I have recovered the Camp Sigil! (Turn in Quest)",
            "nextNodeId": "complete_main_quest_node",
            "conditions": [
              {
                "type": "quest_status",
                "target": "main_quest_bandit_king",
                "operator": "==",
                "value": 0
              },
              {
                "type": "has_item",
                "itemId": "camp_sigil",
                "amount": 1
              }
            ]
          },
          {
            "id": "opt_ask_about",
            "text": "I want to ask about recent events... (Ask about)",
            "nextNodeId": "ask_about_node"
          },
          {
            "id": "opt_gossip",
            "text": "Heard any good rumors lately? (Gossip)",
            "nextNodeId": "gossip_node"
          },
          {
            "id": "opt_leave",
            "text": "Just looking around. (Leave)"
          }
        ]
      },
      "grant_main_quest_node": {
        "id": "grant_main_quest_node",
        "text": "Ah, yes. The Bandit King stole our Camp Sigil! Defeat him in his stronghold and bring it back, please.",
        "options": [
          {
            "id": "opt_accept_main",
            "text": "I will get it back. (Accept)",
            "nextNodeId": "start",
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "main_quest_bandit_king"
              }
            ]
          }
        ]
      },
      "complete_main_quest_node": {
        "id": "complete_main_quest_node",
        "text": "By the gods, you found it! Thank you so much, hero! You have saved our outpost!",
        "options": [
          {
            "id": "opt_complete_main",
            "text": "You're welcome.",
            "nextNodeId": "start",
            "consequences": [
              {
                "type": "complete_quest",
                "questId": "main_quest_bandit_king"
              }
            ]
          }
        ]
      },
      "ask_about_node": {
        "id": "ask_about_node",
        "text": "Alright, what do you want to ask about?",
        "dynamicType": "ask_about",
        "onKnownNodeId": "known_node",
        "onUnknownNodeId": "unknown_node",
        "options": [
          {
            "id": "opt_back",
            "text": "Nevermind. (Go back)",
            "nextNodeId": "start"
          }
        ]
      },
      "gossip_node": {
        "id": "gossip_node",
        "text": "Let me think...",
        "dynamicType": "gossip",
        "onKnownNodeId": "start",
        "options": [
          {
            "id": "opt_back",
            "text": "Nevermind. (Go back)",
            "nextNodeId": "start"
          }
        ]
      },
      "known_node": {
        "id": "known_node",
        "text": "Ah, yes! I've heard about {topic}. {description}",
        "options": [
          {
            "id": "opt_back",
            "text": "I see. (Go back)",
            "nextNodeId": "start"
          }
        ]
      },
      "unknown_node": {
        "id": "unknown_node",
        "text": "{deflection}",
        "options": [
          {
            "id": "opt_back",
            "text": "Alright. (Go back)",
            "nextNodeId": "start"
          }
        ]
      }
    }
  },
  "scout_tree": {
    "id": "scout_tree",
    "startNodeId": "start",
    "nodes": {
      "start": {
        "id": "start",
        "text": "Hail. Keep your distance, I am watching the dungeons.",
        "options": [
          {
            "id": "opt_scout_challenge",
            "text": "Do you have any advice for exploring the dungeons? (Accept tutorial)",
            "nextNodeId": "grant_throwing_node",
            "conditions": [
              {
                "type": "quest_status",
                "target": "tutorial_throwing",
                "operator": "==",
                "value": -1
              }
            ]
          },
          {
            "id": "opt_scout_thanks",
            "text": "I cleared the web barrier in Dungeon 1!",
            "nextNodeId": "complete_throwing_node",
            "conditions": [
              {
                "type": "quest_status",
                "target": "tutorial_throwing",
                "operator": "==",
                "value": 1
              }
            ]
          },
          {
            "id": "opt_ask_about",
            "text": "Have you seen or heard anything? (Ask about)",
            "nextNodeId": "ask_about_node"
          },
          {
            "id": "opt_gossip",
            "text": "What are the latest rumors? (Gossip)",
            "nextNodeId": "gossip_node"
          },
          {
            "id": "opt_leave",
            "text": "Safe hunting. (Leave)"
          }
        ]
      },
      "grant_throwing_node": {
        "id": "grant_throwing_node",
        "text": "The Upper Dungeons are blocked by sticky, flammable spider webs. Take these fire potions and throw them at the webs to clear the path.",
        "options": [
          {
            "id": "opt_accept_throwing",
            "text": "Got it. I'll clear the blockade. (Accept)",
            "nextNodeId": "start",
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "tutorial_throwing"
              }
            ]
          }
        ]
      },
      "complete_throwing_node": {
        "id": "complete_throwing_node",
        "text": "Superb work. Throwing items is a vital skill. Those fire fields burn anything that walks into them.",
        "options": [
          {
            "id": "opt_bye_throwing",
            "text": "Thanks for the tip. (Go back)",
            "nextNodeId": "start"
          }
        ]
      },
      "ask_about_node": {
        "id": "ask_about_node",
        "text": "Make it quick.",
        "dynamicType": "ask_about",
        "onKnownNodeId": "known_node",
        "onUnknownNodeId": "unknown_node",
        "options": [
          {
            "id": "opt_back",
            "text": "Nevermind. (Go back)",
            "nextNodeId": "start"
          }
        ]
      },
      "gossip_node": {
        "id": "gossip_node",
        "text": "Let me think...",
        "dynamicType": "gossip",
        "onKnownNodeId": "start",
        "options": [
          {
            "id": "opt_back",
            "text": "Nevermind. (Go back)",
            "nextNodeId": "start"
          }
        ]
      },
      "known_node": {
        "id": "known_node",
        "text": "I saw that. {description}",
        "options": [
          {
            "id": "opt_back",
            "text": "Good to know. (Go back)",
            "nextNodeId": "start"
          }
        ]
      },
      "unknown_node": {
        "id": "unknown_node",
        "text": "{deflection}",
        "options": [
          {
            "id": "opt_back",
            "text": "Okay. (Go back)",
            "nextNodeId": "start"
          }
        ]
      }
    }
  },
  "merchant_tree": {
    "id": "merchant_tree",
    "startNodeId": "start",
    "nodes": {
      "start": {
        "id": "start",
        "text": "Greetings, traveler! I've got the finest goods in Camp. Looking to trade?",
        "options": [
          {
            "id": "opt_trade",
            "text": "Show me your wares. (Trade)",
            "nextNodeId": "trade_node"
          },
          {
            "id": "opt_leave",
            "text": "Just browsing. (Leave)"
          }
        ]
      },
      "trade_node": {
        "id": "trade_node",
        "text": "Trade window opening...",
        "dynamicType": "trade",
        "options": [
          {
            "id": "opt_back",
            "text": "Go back.",
            "nextNodeId": "start"
          }
        ]
      }
    }
  },
  "scholar_tree": {
    "id": "scholar_tree",
    "startNodeId": "start",
    "nodes": {
      "start": {
        "id": "start",
        "text": "Hello, seeker of truths. I study the lore of this region. What would you like to discuss?",
        "options": [
          {
            "id": "opt_scholar_altar",
            "text": "Can you teach me about the ancient ruins? (Accept tutorial)",
            "nextNodeId": "grant_altar_node",
            "conditions": [
              {
                "type": "quest_status",
                "target": "tutorial_altar",
                "operator": "==",
                "value": -1
              }
            ]
          },
          {
            "id": "opt_scholar_thanks",
            "text": "I made a sacrifice at the ancient altar!",
            "nextNodeId": "complete_altar_node",
            "conditions": [
              {
                "type": "quest_status",
                "target": "tutorial_altar",
                "operator": "==",
                "value": 1
              }
            ]
          },
          {
            "id": "opt_tell_rumor",
            "text": "Share news of the Bandit Stronghold. (Tell rumor)",
            "nextNodeId": "inject_node"
          },
          {
            "id": "opt_ask_about",
            "text": "I want to ask about recent findings... (Ask about)",
            "nextNodeId": "ask_about_node"
          },
          {
            "id": "opt_leave",
            "text": "Farewell. (Leave)"
          }
        ]
      },
      "grant_altar_node": {
        "id": "grant_altar_node",
        "text": "Deep in the Shrine Vault, there is an ancient altar. If you place monster bones upon it, the gods will bestow a powerful wand or vault key. Try it yourself.",
        "options": [
          {
            "id": "opt_accept_altar",
            "text": "I will examine the altar. (Accept)",
            "nextNodeId": "start",
            "consequences": [
              {
                "type": "grant_quest",
                "questId": "tutorial_altar"
              }
            ]
          }
        ]
      },
      "complete_altar_node": {
        "id": "complete_altar_node",
        "text": "Outstanding! The gods have blessed you. Altars are powerful tools for translating feral monster remains into divine aid.",
        "options": [
          {
            "id": "opt_bye_altar",
            "text": "Fascinating. (Go back)",
            "nextNodeId": "start"
          }
        ]
      },
      "inject_node": {
        "id": "inject_node",
        "text": "Fascinating! I shall record this news of the Bandit Stronghold in my archives.",
        "dynamicType": "inject_rumor",
        "injectRumorId": "rumor_chain_bandit_stronghold",
        "options": [
          {
            "id": "opt_back",
            "text": "You are welcome. (Go back)",
            "nextNodeId": "start"
          }
        ]
      },
      "ask_about_node": {
        "id": "ask_about_node",
        "text": "Let us consult the scrolls. What topic is on your mind?",
        "dynamicType": "ask_about",
        "onKnownNodeId": "known_node",
        "onUnknownNodeId": "unknown_node",
        "options": [
          {
            "id": "opt_back",
            "text": "Nevermind. (Go back)",
            "nextNodeId": "start"
          }
        ]
      },
      "known_node": {
        "id": "known_node",
        "text": "Ah, yes! My logs say: {topic}. {description}",
        "options": [
          {
            "id": "opt_back",
            "text": "Interesting. (Go back)",
            "nextNodeId": "start"
          }
        ]
      },
      "unknown_node": {
        "id": "unknown_node",
        "text": "{deflection}",
        "options": [
          {
            "id": "opt_back",
            "text": "I see. (Go back)",
            "nextNodeId": "start"
          }
        ]
      }
    }
  }
}