      "imbue_arrow": {
        "id": "imbue_arrow",
        "name": "Imbue Arrow",
        "category": "sp",
        "description": "Place an area spell upon an arrow so that the spell's area is centered on where the arrow lands."
      },
      "seeker_arrow": {
        "id": "seeker_arrow",
        "name": "Seeker Arrow",
        "category": "sp",
        "description": "Launch an arrow 1/day that travels to a known target, negating cover and concealment modifiers."
      },
      "phase_arrow": {
        "id": "phase_arrow",
        "name": "Phase Arrow",
        "category": "sp",
        "description": "Launch an arrow 1/day that travels in a straight path, passing through nonmagical barriers/walls (negates cover, concealment, and armor/shield)."
      },
      "hail_of_arrows": {
        "id": "hail_of_arrows",
        "name": "Hail of Arrows",
        "category": "sp",
        "description": "In lieu of regular attacks, fire an arrow at each and every target within range 1/day (up to 1 target per arcane archer level)."
      },
      "arrow_of_death": {
        "id": "arrow_of_death",
        "name": "Arrow of Death",
        "category": "sp",
        "description": "Create an arrow of death that forces the target, if damaged by the arrow, to make a DC 20 Fortitude save or be slain immediately."
      }
