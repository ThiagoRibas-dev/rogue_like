      "sneak_attack_1d6": {
        "id": "sneak_attack_1d6",
        "name": "Sneak Attack",
        "category": "ex",
        "description": "Deal extra precision damage (+1d6 at 1st level, increasing by +1d6 every two rogue levels) when target is flanked or denied DEX bonus to AC."
      },
      "trapfinding": {
        "id": "trapfinding",
        "name": "Trapfinding",
        "category": "ex",
        "description": "Use the Search skill to locate traps with DC > 20 and Disable Device to disarm magic traps."
      },
      "evasion": {
        "id": "evasion",
        "name": "Evasion",
        "category": "ex",
        "description": "Take no damage instead of half damage on a successful Reflex saving throw."
      },
      "uncanny_dodge": {
        "id": "uncanny_dodge",
        "name": "Uncanny Dodge",
        "category": "ex",
        "description": "Retain Dexterity bonus to AC even if caught flat-footed or struck by an invisible attacker."
      },
      "rogue_special_ability_1": {
        "id": "rogue_special_ability_1",
        "name": "Rogue Special Ability",
        "category": "ex",
        "description": "Select from Crippling Strike (2 STR damage), Defensive Roll, Improved Evasion, Opportunist, Skill Mastery, or Slippery Mind."
      }
    },
