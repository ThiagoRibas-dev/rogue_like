        "id": "monk_ac_bonus",
        "name": "Monk AC Bonus",
        "category": "ex",
        "description": "When unarmored and unencumbered, add Wisdom bonus (if positive) + 1 per 5 monk levels to AC (applies even against touch attacks or when flat-footed).",
