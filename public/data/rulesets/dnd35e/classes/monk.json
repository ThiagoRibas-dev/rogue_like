      "quivering_palm": {
        "id": "quivering_palm",
        "name": "Quivering Palm",
        "category": "su",
        "description": "Set up fatal vibrations within the body of another creature 1/week (Fortitude save DC 10 + 1/2 monk level + WIS mod or die)."
