        "id": "smite_evil_1",
        "name": "Smite Evil",
        "category": "su",
        "description": "Add CHA bonus to attack roll and paladin level to damage roll against an evil foe (1/day at 1st, +1/day every 5 levels).",
        "resourcePool": {
          "poolId": "smite_evil",
          "maxBase": 1,
          "refreshCycle": "rest_8h"
        }
      },
      "divine_grace": {
