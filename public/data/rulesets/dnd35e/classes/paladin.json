        "id": "aura_of_good",
        "name": "Aura of Good",
        "category": "ex",
        "description": "Power of a paladin's aura of good (see the detect good spell) is equal to paladin level."
      },
      "detect_evil": {
        "id": "detect_evil",
        "name": "Detect Evil",
        "category": "sp",
        "description": "At will, a paladin can use detect evil, as the spell."
