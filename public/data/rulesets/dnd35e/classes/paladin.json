        "category": "su",
        "description": "Immune to fear; allies within 10 ft gain +4 morale bonus on saving throws against fear effects."
      },
      "divine_health": {
        "id": "divine_health",
        "name": "Divine Health",
        "category": "ex",
        "description": "Immune to all diseases, including supernatural and magical diseases."
